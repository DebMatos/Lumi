{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultModel": "lumi-v3"
  },
  "Whisper": {
    "Executable": "~/Projetos/whisper.cpp/build/bin/whisper-cli",
    "ModelPath": "~/Projetos/whisper.cpp/models/ggml-base.bin",
    "FfmpegExecutable": "ffmpeg",
    "TimeoutSeconds": 120,
    "MaxAudioBytes": 10485760,
    "MaxDurationSeconds": 60
  },
  "Speech": {
    "PythonExecutable": "~/Projetos/piper/.venv/bin/python",
    "WorkerScript": "Speech/piper_worker.py",
    "ModelPath": "~/Projetos/piper/pt_PT-tugao-medium.onnx",
    "TimeoutSeconds": 60,
    "MaxTextLength": 4000,
    "QueueCapacity": 3
  }
}
